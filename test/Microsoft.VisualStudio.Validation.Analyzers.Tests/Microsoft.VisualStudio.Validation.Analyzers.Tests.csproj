<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">$(TargetFrameworks);net472</TargetFrameworks>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <UseAppHost>true</UseAppHost>
    <!-- Roslyn's analyzer test workspace uses dynamic MEF composition and cannot execute in
         a NativeAOT test host. -->
    <PublishNativeAOTTests>false</PublishNativeAOTTests>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\nuget.config" Link="nuget.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing.XUnit" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="xunit.v3.assert.aot" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)','net9.0'))" />
    <PackageReference Include="xunit.v3.assert" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)','net9.0'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Microsoft.VisualStudio.Validation.Analyzers.CodeFixes\Microsoft.VisualStudio.Validation.Analyzers.CodeFixes.csproj" />
    <ProjectReference Include="..\..\src\Microsoft.VisualStudio.Validation.Analyzers.CSharp\Microsoft.VisualStudio.Validation.Analyzers.CSharp.csproj" />
    <ProjectReference Include="..\..\src\Microsoft.VisualStudio.Validation.Analyzers\Microsoft.VisualStudio.Validation.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\Microsoft.VisualStudio.Validation\Microsoft.VisualStudio.Validation.csproj" />
  </ItemGroup>

  <Target Name="CopyAnalyzerTestReferenceAssemblies" AfterTargets="Build" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)','net10.0'))">
    <ItemGroup>
      <_AnalyzerTestReferencePack Include="@(ResolvedTargetingPack)" Condition="'%(ResolvedTargetingPack.NuGetPackageId)' == 'Microsoft.NETCore.App.Ref'" />
    </ItemGroup>
    <PropertyGroup>
      <_AnalyzerTestReferencePackDirectory>@(_AnalyzerTestReferencePack->'%(PackageDirectory)')</_AnalyzerTestReferencePackDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_AnalyzerTestReferenceAssemblies Include="$(_AnalyzerTestReferencePackDirectory)\ref\$(TargetFramework)\*.dll" Condition="'$(_AnalyzerTestReferencePackDirectory)' != ''" />
      <FileWrites Include="@(_AnalyzerTestReferenceAssemblies->'$(OutDir)reference-assemblies\%(Filename)%(Extension)')" />
    </ItemGroup>
    <Error Condition="'@(_AnalyzerTestReferenceAssemblies)' == ''" Text="The .NET reference pack for analyzer tests was not found." />
    <Copy SourceFiles="@(_AnalyzerTestReferenceAssemblies)" DestinationFolder="$(OutDir)reference-assemblies" SkipUnchangedFiles="true" />
  </Target>
</Project>
